<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:id="@+id/header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="24dp"
        android:paddingEnd="24dp" android:paddingTop="40dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/tvAvatar" android:layout_width="56dp"
            android:layout_height="56dp" android:gravity="center"
            android:background="@drawable/bg_avatar" android:textColor="#FFFFFF"
            android:textSize="24sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:id="@+id/tvNamaHeader" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pengaturan disimpan di SharedPreferences"
                android:textColor="#DDFFFFFF" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card" android:elevation="3dp"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pengaturan" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/teks"/>
                <EditText android:id="@+id/etNama" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Nama"
                    android:textColor="@color/teks"/>

                <CheckBox android:id="@+id/cbSembunyiSaldo" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Sembunyikan saldo"
                    android:textColor="@color/teks"/>
                <CheckBox android:id="@+id/cbModeGelap" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Mode gelap"
                    android:textColor="@color/teks"/>
                <CheckBox android:id="@+id/cbPengingat" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Pengingat nabung 19:00"
                    android:textColor="@color/teks"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nominal setor cepat" android:layout_marginTop="12dp"
                    android:textColor="@color/teks_redup"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText android:id="@+id/etNominal1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:inputType="number" android:textColor="@color/teks"/>
                    <EditText android:id="@+id/etNominal2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:inputType="number" android:textColor="@color/teks"/>
                    <EditText android:id="@+id/etNominal3" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:inputType="number" android:textColor="@color/teks"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Warna tema" android:layout_marginTop="12dp"
                    android:textColor="@color/teks_redup"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <View android:id="@+id/temaTeal" android:layout_width="44dp"
                        android:layout_height="44dp" android:layout_marginEnd="14dp"/>
                    <View android:id="@+id/temaBiru" android:layout_width="44dp"
                        android:layout_height="44dp" android:layout_marginEnd="14dp"/>
                    <View android:id="@+id/temaUngu" android:layout_width="44dp"
                        android:layout_height="44dp" android:layout_marginEnd="14dp"/>
                    <View android:id="@+id/temaOranye" android:layout_width="44dp"
                        android:layout_height="44dp"/>
                </LinearLayout>

                <Button android:id="@+id/btnSimpan" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="Simpan pengaturan"/>
                <Button android:id="@+id/btnTes" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Tes pengingat sekarang" android:textAllCaps="false"
                    android:background="@drawable/bg_chip" android:textColor="@color/teks"/>

                <TextView android:id="@+id/tvInfoPrefs" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:fontFamily="monospace" android:textSize="12sp"
                    android:textColor="@color/teks_redup"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav"/>
</LinearLayout>
