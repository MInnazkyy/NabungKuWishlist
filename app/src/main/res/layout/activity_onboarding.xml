<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="32dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🎯" android:textSize="56sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Selamat datang di NabungKu Wishlist" android:textSize="24sp"
        android:textStyle="bold" android:gravity="center" android:textColor="@color/teks"
        android:layout_marginTop="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Wujudkan barang impianmu, sedikit demi sedikit."
        android:gravity="center" android:textColor="@color/teks_redup"
        android:layout_marginTop="8dp"/>

    <EditText android:id="@+id/etNama" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Nama panggilanmu"
        android:textColor="@color/teks" android:layout_marginTop="28dp"/>
    <EditText android:id="@+id/etImpian" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Nama impianmu (mis. Laptop)"
        android:textColor="@color/teks"/>
    <EditText android:id="@+id/etSasaran" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Sasaran (Rp), mis. 5000000"
        android:inputType="number" android:textColor="@color/teks"/>

    <Button android:id="@+id/btnFoto" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="🖼 Pilih foto impian (opsional)" android:textAllCaps="false"
        android:background="@drawable/bg_chip" android:textColor="@color/teks"/>
    <ImageView android:id="@+id/ivFoto" android:layout_width="match_parent"
        android:layout_height="140dp" android:layout_marginTop="8dp"
        android:scaleType="centerCrop" android:background="@drawable/bg_chip"
        android:clipToOutline="true" android:visibility="gone"/>

    <Button android:id="@+id/btnMulai" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Mulai menabung"
        android:layout_marginTop="16dp"/>
</LinearLayout>
</ScrollView>
