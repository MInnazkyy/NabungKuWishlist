<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="68dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/card" android:elevation="10dp">

    <TextView android:id="@+id/navBeranda" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:textSize="11sp" android:text="Beranda"
        android:drawableTop="@drawable/ic_home" android:drawablePadding="2dp"/>
    <TextView android:id="@+id/navTarget" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:textSize="11sp" android:text="Target"
        android:drawableTop="@drawable/ic_target" android:drawablePadding="2dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center">
        <TextView android:id="@+id/navSetor" android:layout_width="54dp"
            android:layout_height="54dp" android:gravity="center"
            android:text="+" android:textSize="30sp" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <TextView android:id="@+id/navRiwayat" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:textSize="11sp" android:text="Riwayat"
        android:drawableTop="@drawable/ic_history" android:drawablePadding="2dp"/>
    <TextView android:id="@+id/navProfil" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:textSize="11sp" android:text="Profil"
        android:drawableTop="@drawable/ic_person" android:drawablePadding="2dp"/>
</LinearLayout>
